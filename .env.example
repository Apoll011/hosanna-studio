# API origin including /api suffix (e.g. https://api.hosanna.live/api)
VITE_API_URL="http://localhost:3000/api"

# Cloudflare Turnstile site key (login / register)
VITE_TURNSTILE_SITE_KEY="your-cloudflare-turnstile-site-key"

# PostHog (optional — only initializes in production unless DEV=true)
VITE_PUBLIC_POSTHOG_KEY="your-posthog-project-api-key"
VITE_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
# PostHog only initializes in production builds. Set this to "true", with a development
# project key above, to send events from the dev server.
VITE_PUBLIC_POSTHOG_DEV="false"
